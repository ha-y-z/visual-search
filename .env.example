# Copy to .env and fill in. docker-compose.yml reads this file automatically.

# --- apps/api ---
GOOGLE_API_KEY=
# DATA_DIR is set to /data by docker-compose.yml (the bind mount target);
# only override if you change that mount.
# DATA_DIR=/data
RERANK_ENABLED=true
# CPU reranking of the 2B model takes ~22-27s/query, well above the app's
# own default of 10s (tuned for GPU). docker-compose.yml already raises
# this to 30s for the CPU path; docker-compose.gpu.yml tightens it back to
# 10s. Override here only if your hardware needs a different value.
RERANKER_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# --- services/reranker ---
RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-2B
# auto | cuda | cpu -- auto picks cuda when available (see docker-compose.gpu.yml)
RERANKER_DEVICE=auto
