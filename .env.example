# Copy to .env and fill in. docker-compose.yml reads this file automatically.

# --- apps/api ---
_API_KEY=
# DATA_DIR is set to /data by docker-compose.yml (the bind mount target);
# only override if you change that mount.
# DATA_DIR=/data
RERANK_ENABLED=true
LOG_LEVEL=INFO

# --- services/reranker ---
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# auto | cuda | cpu -- auto picks cuda when available (see docker-compose.gpu.yml)
RERANKER_DEVICE=auto
